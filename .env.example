# Google Gemini API (required - used for LLM analysis and embeddings)
GOOGLE_API_KEY=your-google-api-key-here

# PostgreSQL Database (required - includes VectorChord extension)
DATABASE_URL=postgresql://user:password@localhost:5432/jafar

# SMTP Credentials (required - for sending digest emails)
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your-app-specific-password